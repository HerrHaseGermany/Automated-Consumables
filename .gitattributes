# Keep development files in Git, but omit them from source/release archives.
/.gitattributes export-ignore
/.gitignore export-ignore
/.github export-ignore
/.pkgmeta export-ignore
/.vscode export-ignore
/AGENTS.md export-ignore
/tests export-ignore
/tools export-ignore
/ref export-ignore
/.cache export-ignore
/dist export-ignore
/data/README.md export-ignore
/data/published export-ignore
/data/reports export-ignore
/data/seeds export-ignore
/data/sources export-ignore
/data/staged export-ignore
